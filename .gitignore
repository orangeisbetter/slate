# Runtime state. The SQLite database holds every account, password hash, session and project,
# so it must never be committed. db/ holds the .sql migrations and is deliberately not ignored.
/data/
*.db
*.db-wal
*.db-shm
*.bak
*.sqlite
*.sqlite3
/.env

# The test suite's own environment and bytecode.
/tests/.venv/
/tests/__pycache__/
/.pytest_cache/

# Composer. composer.json and composer.lock are committed; the tree composer installs into is not.
/vendor/
